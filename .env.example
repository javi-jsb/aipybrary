# PostgreSQL
POSTGRES_USER=aipybrary
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aipybrary
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_TEST_DB=aipybrary_test

# JWT
# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
# Do NOT use a hardcoded default in production — set this via the environment or a secrets manager.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
# Comma-separated list of origins allowed to call the API cross-origin.
# Defaults to the Vite dev server origin if unset.
CORS_ALLOW_ORIGINS=http://localhost:5173
